{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalStacker",
  "version": "1.0.0",
  "identifier": "com.localstacker.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalStacker",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/thuanlegit/localstacker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyODhGNTkxMDAwODAwMDAKUldRQUFBZ0FrZldJWW03OW5paVBWR1FpallVaklZYnRqUDFHelZKZ2J0K1ZQcGlBM1p6NlBOTysK"
    }
  }
}
